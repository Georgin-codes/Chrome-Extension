{
  "manifest_version": 3,
  "name": "Workspace",
  "version": "1.0.0",
  "description": "A simple chrome extension to save and edit workspace",
  "action":{
    "default_icon": "./images/app-icon.jpg",
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups"
  ]

}